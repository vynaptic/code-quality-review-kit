  "allowed_prefixes": {
    "_comment": "Prefixes that are not verbs but are idiomatic. 'next_word_must_be_verb' means the following word is checked as the verb (tryParseAmount).",
    "conversion": ["as", "from", "into", "of", "to", "with"],
    "event": ["on"],
    "hook": ["use"],
    "next_word_must_be_verb": ["try", "maybe", "safe", "safely", "async", "auto", "batch", "bulk", "force", "lazy", "lazily", "pre", "post", "re", "un"],
