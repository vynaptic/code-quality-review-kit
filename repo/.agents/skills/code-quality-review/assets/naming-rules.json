  "banned_type_suffixes": {
    "Manager":   {"confidence": "medium", "hint": "OK only for a resource-lifecycle manager (TransactionManager, CacheManager, ConnectionManager). Otherwise name the real responsibility: what does it calculate, store, schedule or coordinate? (e.g. FeeCalculator, PayoutScheduler)."},
    "Helper":    {"confidence": "high",   "hint": "Name the real responsibility (e.g. IbanFormatter, RetryPolicy)."},
    "Helpers":   {"confidence": "high",   "hint": "Split by responsibility and name each class for it."},
    "Util":      {"confidence": "high",   "hint": "Name the real responsibility (e.g. SlugFormatter, CurrencyConverter)."},
    "Utils":     {"confidence": "medium", "hint": "OK only as the Spring/Apache static holder: final class, private constructor, all static, stateless, no dependencies, ONE subject in the prefix (StringUtils). Otherwise split by responsibility and name each class for it."},
    "Utility":   {"confidence": "high",   "hint": "Name the real responsibility."},
    "Utilities": {"confidence": "high",   "hint": "Split by responsibility."},
    "Data":      {"confidence": "medium", "hint": "Use the domain noun; 'Data' adds nothing."},
    "Info":      {"confidence": "medium", "hint": "Use the domain noun (e.g. ShippingAddress, not AddressInfo)."},
    "Object":    {"confidence": "medium", "hint": "Use the domain noun."},
    "Stuff":     {"confidence": "high",   "hint": "Use the domain noun."},
    "Thing":     {"confidence": "high",   "hint": "Use the domain noun."},
    "Misc":      {"confidence": "high",   "hint": "Split and name by responsibility."},
    "Impl":      {"confidence": "medium", "hint": "Name the implementation by its distinguishing trait (e.g. JdbcOrderRepository)."},
    "Wrapper":   {"confidence": "medium", "hint": "Name what it adds (Decorator: CachingX, RetryingX) or what it adapts (Adapter)."},
    "Processor": {"confidence": "low",    "hint": "OK if it is a real domain term (payment processor); otherwise name what it produces."},
    "Handler":   {"confidence": "low",    "hint": "OK for event/command/request handlers (OrderPlacedHandler); otherwise name the responsibility."}
  },

  "banned_type_prefixes": {
    "Common":  {"confidence": "medium", "hint": "Name by responsibility, not by sharing."},
    "Misc":    {"confidence": "high",   "hint": "Split and name by responsibility."},
    "General": {"confidence": "medium", "hint": "Name by responsibility."},
    "My":      {"confidence": "medium", "hint": "Use the domain noun."}
